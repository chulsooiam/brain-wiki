{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x scripts/detect-transport.sh ] && bash scripts/detect-transport.sh >/dev/null 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
